#include <windows.h>
#include "../src/resource.h"
IDI_APP ICON "app.ico"
1 RT_MANIFEST "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,1
PRODUCTVERSION 0,1,0,1
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Workpaper PDF"
      VALUE "ProductName", "Workpaper PDF"
      VALUE "FileVersion", "0.1.0.1"
      VALUE "ProductVersion", "0.1.0 (build 1)"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
